{
  "name": "gitlean",
  "displayName": "GitLean: Token-Efficient Git Reviewer",
  "description": "Smart local proxy that intercepts IDE coding assistant calls, compresses pulled changes via Paritok, and displays side-by-side context diffs.",
  "version": "1.0.0",
  "publisher": "chineduemma007",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Collaboration"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlean-sidebar",
          "title": "GitLean",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "gitlean-sidebar": [
        {
          "id": "gitlean-analytics-view",
          "name": "Token Savings Analytics"
        },
        {
          "id": "gitlean-diff-selector",
          "name": "Pulled Code Context"
        }
      ]
    },
    "commands": [
      {
        "command": "gitlean.startProxy",
        "title": "GitLean: Start Local Compression Proxy"
      },
      {
        "command": "gitlean.stopProxy",
        "title": "GitLean: Stop Local Compression Proxy"
      },
      {
        "command": "gitlean.showDiffVisualizer",
        "title": "GitLean: Open Split-Screen Context Visualizer"
      }
    ],
    "configuration": {
      "title": "GitLean",
      "properties": {
        "gitlean.paritokApiKey": {
          "type": "string",
          "default": "pk_live_iqkn9k5Csp8IkEYkHim5trSXTGRQnrZb",
          "description": "Paritok Hosted API Key for context-semantic compression."
        },
        "gitlean.proxyPort": {
          "type": "number",
          "default": 8000,
          "description": "Local port where the GitLean proxy server will listen."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "axios": "^1.3.4"
  }
}
